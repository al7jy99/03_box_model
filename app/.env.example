# StarBoard configuration — copy to .env and adjust for production.

# Port the server listens on
PORT=3000

# Secret used to sign JWT session tokens. CHANGE THIS in production —
# use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-secret

# Path to the SQLite database file
DB_PATH=./data/starboard.db

# Credentials created for the platform super admin by `npm run seed`
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me
